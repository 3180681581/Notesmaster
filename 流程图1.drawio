        <mxCell id="h9mr4lZ7T520WFHeFGkf-47" value="用户打开应用" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1562" y="20" width="156" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-48" value="[NoteEditActivity.java]&#xa;NotesListActivity.onCreate()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1509" y="124" width="262" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-49" value="WorkingNote.init() 初始化数据&#xa;说明：初始化笔记的运行时数据（标题、内容、颜色等）&#xa;这些数据会暂时存放在内存中，用户编辑时操作这些内存数据" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1003" y="252" width="260" height="222" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-50" value="NotesListAdapter 创建适配器&#xa;说明：适配器是 ListView 和数据之间的桥梁&#xa;它将数据库中的笔记数据转换成 UI 能显示的形式" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1313" y="276" width="260" height="174" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-51" value="PreferenceManager.getDefaultSharedPreferences() 读取配置&#xa;说明：从 SharedPreferences 读取用户的偏好设置&#xa;（如默认背景色、字体大小等），这是 Android 系统提供的&#xa;轻量级键值对存储，用于存放用户配置" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1623" y="276" width="427" height="174" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-52" value="ContentResolver.query(CONTENT_NOTE_URI, ...) 查询笔记列表&#xa;说明：通过 ContentResolver（内容解析器）查询笔记数据&#xa;ContentProvider 会接收这个查询请求，然后从数据库中&#xa;获取数据并返回 Cursor（游标）对象" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2100" y="264" width="386" height="198" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-53" value="用户点击新建笔记按钮&#xa;说明：用户在 UI 上的交互被 Android 系统捕获&#xa;触发 Activity 中定义的点击监听器（OnClickListener）" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2163" y="524" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-54" value="[NoteEditActivity.java]&#xa;NoteEditActivity.onCreate()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2164" y="724" width="258" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-55" value="WorkingNote.newNote(Context) 创建新笔记对象" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1980" y="912" width="293" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-56" value="mNoteId = 0（表示新笔记）&#xa;说明：笔记 ID 为 0 表示这是一个新创建的笔记&#xa;还没有被保存到数据库" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1669" y="1148" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-57" value="mContent = 空字符串&#xa;说明：内容初始化为空字符串" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1979" y="1160" width="260" height="102" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-58" value="mBgColorId = ResourceParser.getDefaultBgColorId()&#xa;说明：从资源解析器获取默认的背景颜色 ID&#xa;背景颜色使用 ID 而不是直接的 RGB 值，好处是&#xa;可以集中管理颜色，修改时只需改一个地方" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2289" y="1100" width="328" height="222" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-59" value="Note.createNewNote(context) 初始化 Note 对象&#xa;说明：Note 对象是数据模型，用于管理笔记与数据库的交互&#xa;它会为新笔记生成一个 Note 对象，等待后续的保存操作" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2667" y="1124" width="282" height="174" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-60" value="NoteEditText.setHint() 设置提示&#xa;说明：在文本框中显示灰色的提示文字请输入笔记内容...&#xa;帮助用户理解这个输入框的用途" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2657" y="852" width="260" height="198" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-61" value="setContentView(R.layout.note_edit) 显示编辑布局&#xa;说明：从 XML 布局文件加载 UI，显示编辑界面&#xa;包括文本输入框、背景色选择器、提醒按钮等" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2967" y="864" width="325" height="174" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-62" value="用户输入笔记内容&#xa;说明：用户在 NoteEditText 中敲击键盘&#xa;每次输入都会触发文本监听事件" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2999" y="1136" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-63" value="[NoteEditText.java]&#xa;NoteEditText.onTextChanged()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2990" y="1372" width="279" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-64" value="什么时候会被调用？&#xa;每当用户在文本框中输入或删除字符时，这个方法就会被触发" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2844" y="1524" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-65" value="用途是什么？&#xa;实时监听文本变化，更新内存中的笔记内容&#xa;这样做的好处是用户不用每次按保存按钮，系统会自动保存" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3154" y="1500" width="260" height="174" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-66" value="WorkingNote.setWorkingText(text) 更新内容到内存&#xa;说明：将新输入的文本保存到 WorkingNote 对象中&#xa;这时数据还只在内存里，没有写入数据库" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3464" y="1500" width="312" height="174" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-67" value="用户点击保存/返回&#xa;说明：用户完成编辑后点击返回按钮或点击保存&#xa;触发 onPause() 生命周期方法" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3490" y="1724" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-68" value="[NoteEditActivity.java]&#xa;NoteEditActivity.onPause()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3495" y="1924" width="251" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-69" value="什么是 onPause？&#xa;Activity 生命周期中的一个重要方法&#xa;当 Activity 即将进入后台或被销毁时调用&#xa;这是保存数据的最后机会" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3335" y="2052" width="260" height="174" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-70" value="为什么在这里保存？&#xa;确保用户离开时数据不会丢失&#xa;如果等到 onDestroy 再保存，可能来不及" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3645" y="2064" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-71" value="WorkingNote.saveNote() 保存笔记" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3955" y="2100" width="260" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-72" value="[WorkingNote.java]&#xa;WorkingNote.saveNote()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3968" y="2276" width="234" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-73" value="这个方法做的是什么？&#xa;将内存中的数据同步到数据库" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2971" y="2440" width="260" height="102" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-74" value="Note.syncNote() 同步笔记数据" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2971" y="2652" width="260" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-75" value="[Note.java]&#xa;Note.syncNote()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3013" y="2804" width="176" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-76" value="为什么使用 ContentProviderOperation？&#xa;ContentProviderOperation 允许批量操作&#xa;即使操作失败也可以全部回滚，保证数据一致性" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2465" y="2932" width="264" height="174" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-77" value="ContentProviderOperation.Builder 创建操作&#xa;说明：使用 Builder 模式构建操作&#xa;这是一种常见的设计模式，让代码更清晰" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2779" y="2944" width="309" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-78" value="区分新建笔记（mNoteId == 0）" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3138" y="2980" width="260" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-79" value="createNote() 创建新笔记" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1746" y="3156" width="237" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-80" value="builder.withUri(CONTENT_NOTE_URI)&#xa;指定操作的 URI（数据源）&#xa;content://micode_notes/note 表示要操作的是笔记表" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="800" y="3320" width="327" height="126" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-81" value="builder.withValue(NoteColumns.SNIPPET, snippet)&#xa;设置笔记摘要（标题）" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1177" y="3332" width="357" height="102" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-82" value="builder.withValue(NoteColumns.CREATED_DATE, timestamp)&#xa;设置创建时间（当前系统时间）" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1583" y="3332" width="408" height="102" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-83" value="builder.withValue(NoteColumns.TYPE, TYPE_NOTE)&#xa;设置笔记类型（区分笔记、文件夹等）" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2042" y="3332" width="337" height="102" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-84" value="ContentResolver.applyBatch(AUTHORITY, operations)&#xa;说明：一次性提交所有操作到 ContentProvider&#xa;这比多次调用要高效得多" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2428" y="3308" width="357" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-85" value="创建笔记内容（Data 表）" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3765" y="3156" width="242" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-86" value="为什么要分两个表存储？&#xa;note 表存储笔记的元数据（标题、创建时间、背景色等）&#xa;data 表存储笔记的实际内容（正文）&#xa;这样做的好处是可以只查询元数据而不加载全部内容，提高查询速度" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2861" y="3260" width="260" height="246" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-87" value="insertTextData() 插入文本数据" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3409" y="3344" width="260" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-88" value="builder.withUri(CONTENT_DATA_URI)&#xa;指定操作的是 data 表" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2765" y="3580" width="323" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-89" value="builder.withValue(DataColumns.MIME_TYPE, NOTE)&#xa;设置 MIME 类型（text/note 表示文本笔记）&#xa;这样可以支持不同类型的内容（如通话记录）" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3138" y="3556" width="380" height="126" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-90" value="builder.withValue(DataColumns.CONTENT, mContent)&#xa;设置实际的笔记内容" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3568" y="3568" width="366" height="102" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-91" value="ContentResolver.applyBatch()&#xa;提交数据表的操作" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3984" y="3580" width="272" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-92" value="更新修改时间戳" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4631" y="3356" width="172" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-93" value="updateNote()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4305" y="3592" width="156" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-94" value="builder.withValue(NoteColumns.MODIFIED_DATE, System.currentTimeMillis())&#xa;每次修改都更新这个时间戳，用于排序和显示最后修改时间" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4511" y="3556" width="413" height="126" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-95" value="ContentResolver.applyBatch()&#xa;提交更新操作" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4974" y="3580" width="272" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-96" value="更新 Widget 显示（如有关联）&#xa;说明：如果用户为这个笔记创建了 Widget&#xa;需要及时更新 Widget 的显示内容" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4110" y="2404" width="260" height="174" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-97" value="if（mWidgetId != INVALID_APPWIDGET_ID）&#xa;检查是否有关联的 Widget" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3281" y="2640" width="260" height="102" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-98" value="NoteWidgetProvider_2x.updateWidget() 或 NoteWidgetProvider_4x.updateWidget()&#xa;调用 Widget Provider 更新桌面小部件" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4105" y="2628" width="350" height="126" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-99" value="[NotesProvider.java]&#xa;NotesProvider.insert()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2499" y="3580" width="216" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-100" value="什么是 ContentProvider？&#xa;Android 系统提供的标准数据共享机制&#xa;app 不能直接访问其他 app 的数据库，必须通过 ContentProvider&#xa;即使是自己的应用，也建议通过 ContentProvider 访问本地数据库&#xa;好处：1. 统一的数据访问接口 2. 可以轻松支持数据同步和观察者模式 3. 便于权限管理" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2012" y="3732" width="260" height="342" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-101" value="mMatcher.match(uri) 判断 URI 类型&#xa;说明：UriMatcher 是一个路由器，根据 URI 判断要操作哪个表&#xa;这样可以通过同一个 ContentProvider 管理多个表" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2322" y="3792" width="260" height="222" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-102" value="getWritableDatabase() 获取写连接&#xa;说明：获取可读写的数据库连接&#xa;与 getReadableDatabase() 不同，这个可以修改数据" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="2632" y="3816" width="260" height="174" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-103" value="database.insert(TABLE.NOTE, null, values) 执行插入&#xa;说明：调用 SQLiteDatabase 的 insert 方法插入数据&#xa;这是 Android SQLite 驱动层的调用" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3663" y="3816" width="276" height="174" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-104" value="[NotesDatabaseHelper.java]&#xa;NotesDatabaseHelper.getWritableDatabase()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3612" y="4124" width="378" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-105" value="SQLiteOpenHelper.getWritableDatabase()&#xa;说明：这是 Android SQLite 库的核心类&#xa;它负责创建和升级数据库" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3201" y="4276" width="356" height="102" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-106" value="如果数据库不存在调用 onCreate()&#xa;database.execSQL(CREATE_NOTE_TABLE_SQL)&#xa;database.execSQL(CREATE_DATA_TABLE_SQL)&#xa;说明：首次使用时创建表结构&#xa;这个 SQL 在 onCreate 方法中定义" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3607" y="4252" width="389" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-107" value="返回可写的数据库连接&#xa;说明：返回的是 SQLiteDatabase 对象&#xa;可以用来执行 SQL 操作" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4046" y="4264" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-108" value="SQLiteDatabase.insert() 执行&#xa;说明：这是 SQLite 库的最底层调用&#xa;将数据实际写入数据库文件" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4046" y="4452" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-109" value="INSERT INTO note（columns...） VALUES（values...）&#xa;这是实际执行的 SQL 语句" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3891" y="4664" width="260" height="126" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-110" value="返回新插入的行 ID&#xa;说明：数据库自动为新行分配一个唯一的 ID&#xa;这个 ID 会被用于后续的查询、更新、删除操作" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4201" y="4652" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-111" value="[NotesProvider.java]&#xa;NotesProvider.insert() 返回" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4204" y="4852" width="253" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-112" value="getContext().getContentResolver().notifyChange(uri, null)&#xa;说明：这一步非常重要！&#xa;它告诉系统我已经修改了这个数据&#xa;所有监听这个 URI 的观察者都会收到通知" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="3893" y="4980" width="445" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-113" value="返回 Uri（新笔记的 URI）&#xa;说明：返回 content://micode_notes/note/123 这样的 URI&#xa;123 是新笔记的 ID" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4388" y="4980" width="316" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-114" value="[NoteEditActivity.java]&#xa;NoteEditActivity 获取返回" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4423" y="5180" width="246" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-115" value="WorkingNote.mNoteId = 新笔记ID&#xa;说明：更新内存中的笔记 ID&#xa;从此以后，这个笔记就有了数据库中的真实 ID" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4261" y="5308" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-116" value="更新 UI（如显示笔记ID）&#xa;说明：刷新界面，让用户看到最新状态" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4571" y="5332" width="260" height="102" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-117" value="[NoteEditActivity.java]&#xa;NoteEditActivity.onDestroy()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4569" y="5508" width="264" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-118" value="finish() 返回列表&#xa;说明：关闭编辑 Activity，返回到笔记列表 Activity" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4414" y="5636" width="260" height="102" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-119" value="触发 NotesListActivity.onResume()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4724" y="5648" width="268" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-120" value="[NotesListActivity.java]&#xa;NotesListActivity.onResume()" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4724" y="5788" width="268" height="78" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-121" value="说明：当 NotesListActivity 重新获得焦点时调用&#xa;这是更新 UI 的好时机" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4235" y="5952" width="260" height="102" as="geometry" />
        </mxCell>
        <mxCell id="h9mr4lZ7T520WFHeFGkf-122" value="ContentResolver.query() 重新查询笔记列表&#xa;说明：从数据库查询最新的笔记列表&#xa;这会获得一个新的 Cursor，包含新创建的笔记" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="4545" y="5916" width="260" height="174" as="geometry" />
        </mxCell>

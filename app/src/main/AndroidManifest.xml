<?xml version="1.0" encoding="utf-8"?>
        <!--属性：命名空间-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
<!--包名在build.gradle（app）中，为net.micode.notes-->
      <!--    应用需要的权限    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS" />
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.USE_CREDENTIALS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notesmaster"
        tools:targetApi="31">
<!--allowBackup表示应用是否参与系统备份-->
<!--dataExtractionRules="@xml/data_extraction_rules"指定一个 XML 文件（位于 res/xml/ 目录），
用于定义 Android 14（API 34）及以上版本的备份与恢复规则
fullBackupContent用于定义 Android 6.0（API 23）及以上版本的自动备份规则-->
<!--icon=@mipmap/ic_launcher表示这个资源是mipmap目录的ic_launcher文件，几个mipmap目录代表几个不同的屏幕密度，
其下两个文件一个是方形形状一个是圆形形状。其中.anydpi中的.xml表示矢量图，能够自适应不同屏幕密度，减少需要包含的
图片数量。.webp表示位图，是旧机型不支持矢量图时的降级方案，需要为不同屏幕密度准备图片-->
<!--label="@string/app_name"，应用的默认显示名称（用户可见）
图标名称可能由启动 Activity 的 label 属性覆盖-->
<!--supportsRtl="true"声明应用是否支持从右到左（RTL）的布局方向-->
<!--theme="@style/Theme.Notesmaster"为应用中的所有 Activity 指定默认主题，定义应用的整体视觉风格（颜色、动画、控件样式等）
主题通常定义在 res/values/styles.xml 中。单个 Activity 可以设置自己的 android:theme 覆盖此默认值。-->
<!--tools:targetApi="31"这是一个 tools 命名空间 的属性，用于告诉 Android Studio 等工具：该属性（此处指整个 <application>
标签中的某些属性）仅在 API 31（Android 12）及以上版本 生效。避免 Lint 报错“该属性在低版本不可用”-->

<!-- activity 是 Android 四大组件之一，代表应用程序中一个拥有用户界面的单一屏幕
每一个继承自 Activity 或 AppCompatActivity 的类，只要它想要成为一个可供用户交互的界面，就必须在 AndroidManifest.xml 中显式地声明它。-->

<!--android:name：指定 Activity 的类名（必填）
:configChanges 告诉系统：当指定的设备配置发生变化时，不要销毁并重建 Activity，而是由 Activity 自己处理变化（通过重写 onConfigurationChanged() 方法）
:label：设置 Activity 的标题（显示在顶部 ActionBar/Toolbar）以及启动器图标下方的名称。
:launchMode：指定启动模式（standard、singleTop、singleTask、singleInstance），控制任务栈中 Activity 的实例化方式 singleTop 行为：
如果目标 Activity 的实例已位于任务栈的栈顶，则系统不会创建新实例，而是通过 onNewIntent() 将新 Intent 传递给已有的栈顶实例。
:theme：为该 Activity 单独设置主题（如全屏、对话框样式）。
:uiOptions="splitActionBarWhenNarrow"在窄屏幕（如手机横屏）时，将 ActionBar 的选项菜单项拆分到底部栏显示
:windowSoftInputMode 用于指定 Activity 窗口与软键盘的交互方式。adjustPan 是其中一种模式。
:exported：是否允许其他应用启动该 Activity。如果 Activity 包含 intent-filter，通常默认为 true；如果不包含，默认为 false。

<intent-filter> 用于声明一个组件（如 Activity、Service、BroadcastReceiver）能够响应哪些隐式 Intent。
action 定义“做什么”（What）。
category 定义“在什么情况下做”（Context / Role）。
data 定义对什么数据做这个动作-->
        <activity
            android:name=".ui.NotesListActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/NoteTheme"
            android:uiOptions="splitActionBarWhenNarrow"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
<!--定义了 Activity 作为应用的入口以及启动器图标的对应关系-->
        </activity>


        <activity
            android:name=".ui.NoteEditActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:launchMode="singleTop"
            android:theme="@style/NoteTheme"
            android:exported="true">

            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
<!--表示“查看”某个内容-->
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/text_note" />
<!--android:mimeType	数据的 MIME 类型-->
<!--vnd.android.cursor.item/text_note：自定义 MIME 类型，表示“文本笔记”类型的数据项-->
                <data android:mimeType="vnd.android.cursor.item/call_note" />
            </intent-filter >

            <intent-filter>
                <action android:name="android.intent.action.INSERT_OR_EDIT" />
<!--插入或编辑（INSERT_OR_EDIT）指定 MIME 类型的笔记数据-->
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/text_note" />
                <data android:mimeType="vnd.android.cursor.item/call_note" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
<!--处理搜索请求（SEARCH）通常用于支持系统全局搜索或应用内搜索框查询词不是数据而是参数-->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
<!--<meta-data> 以键值对的形式为组件添加额外配置信息，供系统或应用在运行时读取-->
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
<!--android.app.searchable 是系统定义的键，用于关联 Activity 与搜索配置
@xml/searchable 指向一个描述搜索行为的 XML 文件。-->
        </activity>

        <!--内容提供者（Content Provider）：用于管理笔记数据的数据库访问-->
        <provider
            android:name="net.micode.notes.data.NotesProvider"
            android:authorities="micode_notes"
            android:multiprocess="true" />
        <!--android:name 指向 NotesProvider 类，负责处理数据库查询、插入、更新、删除操作
        android:authorities="micode_notes" 定义此内容提供者的权限标识
        android:multiprocess="true" 允许多个进程同时访问此提供者-->

        <!--2x2 大小的应用小部件提供者（Widget Provider）：在桌面显示笔记快捷方式-->
        <receiver
            android:name=".widget.NoteWidgetProvider_2x"
            android:label="@string/app_widget2x2"
            android:exported="true">
            <intent-filter>
                <!--监听小部件更新动作-->
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!--监听小部件被删除-->
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
                <!--监听隐私模式变化-->
                <action android:name="android.intent.action.PRIVACY_MODE_CHANGED" />
            </intent-filter>

            <!--关联小部件的配置信息-->
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_2x_info" />
        </receiver>
        <!--4x4 大小的应用小部件提供者（Widget Provider）：在桌面显示更大的笔记快捷方式-->
        <receiver
            android:name=".widget.NoteWidgetProvider_4x"
            android:label="@string/app_widget4x4"
            android:exported="true">

            <intent-filter>
                <!--监听小部件更新动作-->
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!--监听小部件被删除-->
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
                <!--监听隐私模式变化-->
                <action android:name="android.intent.action.PRIVACY_MODE_CHANGED" />
            </intent-filter>

            <!--关联小部件的配置信息-->
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_4x_info" />
        </receiver>

        <!--广播接收者：系统启动时初始化闹钟-->
        <receiver android:name=".ui.AlarmInitReceiver"
            android:exported="true">
            <intent-filter>
                <!--监听系统启动完成事件-->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--广播接收者：处理闹钟触发事件（运行在单独进程中）-->
        <receiver
            android:name="net.micode.notes.ui.AlarmReceiver"
            android:process=":remote" >
        </receiver>

        <!--闹钟提醒界面：当闹钟触发时弹出的提醒活动-->
        <activity
            android:name=".ui.AlarmAlertActivity"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Holo.Wallpaper.NoTitleBar" >
        <!--android:launchMode="singleInstance" 确保只有一个实例存在于整个系统
        android:theme="@android:style/Theme.Holo.Wallpaper.NoTitleBar" 使用壁纸背景且无标题栏的主题-->
        </activity>

        <!--应用设置界面：用户可在此修改应用偏好设置-->
        <activity
            android:name="net.micode.notes.ui.NotesPreferenceActivity"
            android:label="@string/preferences_title"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Holo.Light" >
        <!--android:theme="@android:style/Theme.Holo.Light" 使用亮色主题-->
        </activity>

        <!--后台服务：同步笔记数据到 Google 任务（需在单独进程中运行）-->
        <service
            android:name="net.micode.notes.gtask.remote.GTaskSyncService"
            android:exported="false" >
        <!--android:exported="false" 此服务仅供本应用内部使用，不允许其他应用调用-->
        </service>

        <!--设置默认可搜索的 Activity，用于系统搜索集成-->
        <meta-data
            android:name="android.app.default_searchable"
            android:value=".ui.NoteEditActivity" />

        <!--        <activity-->
        <!--            android:name=".MainActivity"-->
        <!--            android:exported="true">-->
        <!--            <intent-filter>-->
        <!--                <action android:name="android.intent.action.MAIN" />-->

        <!--                <category android:name="android.intent.category.LAUNCHER" />-->
        <!--            </intent-filter>-->
        <!--        </activity>-->

    </application>

</manifest>

        <mxCell id="GydwUbJ-rMB7G1sl1qg6-10" value="Intent intent = new Intent(Intent.ACTION_VIEW)&#xa;说明：ACTION_VIEW 表示查看/打开文件" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="432" y="788" width="263" height="126" as="geometry" />
        </mxCell>
        <mxCell id="GydwUbJ-rMB7G1sl1qg6-11" value="intent.setDataAndType(Uri.parse(mImageUri), &#39;image/*&#39;)&#xa;说明：设置要打开的数据（图片 Uri）和 MIME 类型&#xa;mImageUri 从数据库读取，例如：&#39;content://...&#39;" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">

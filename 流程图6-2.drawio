        </mxCell>
        <mxCell id="GydwUbJ-rMB7G1sl1qg6-2" value="[NoteEditActivity.java]&#xa;NoteEditActivity.onOptionsItemSelected(MenuItem item)" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="GydwUbJ-rMB7G1sl1qg6-12" value="intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)&#xa;说明：授予被启动应用的读权限" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="315" y="1188" width="497" height="78" as="geometry" />
